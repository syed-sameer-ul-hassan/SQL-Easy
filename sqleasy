#!/usr/bin/env python3

import sys
import os
import subprocess

R = "\033[31m"
G = "\033[32m"
Y = "\033[33m"
C = "\033[36m"
W = "\033[0m"

CONFIG_FILE = os.path.expanduser("~/.config/sqleasy/path")

def get_install_dir():
    if os.path.isdir("/usr/share/sqleasy"):
        return "/usr/share/sqleasy"
    if os.path.isfile(CONFIG_FILE):
        with open(CONFIG_FILE, "r") as f:
            path = f.read().strip()
        if os.path.isdir(path):
            return path
    print(f"{R}[-] SQL Easy installation path not found.{W}")
    print(f"{Y}[*] Please re-run the installer from the project directory:{W}")
    print(f"{C}    cd /path/to/SQL-Easy && sudo bash install.sh{W}\n")
    sys.exit(1)

def print_banner():
    print(f"{C}")
    print("███████  ██████  ██          ███████  █████  ███████ ██    ██ ")
    print("██      ██    ██ ██          ██      ██   ██ ██       ██  ██  ")
    print("███████ ██    ██ ██          █████   ███████ ███████   ████   ")
    print("     ██ ██ ▄▄ ██ ██          ██      ██   ██      ██    ██    ")
    print("███████  ██████  ███████     ███████ ██   ██ ███████    ██    ")
    print("            ▀▀                                                ")
    print(f"{Y}              [ SQL Easy Automation Framework v1.1.0 ]{W}\n")

def print_help():
    print_banner()
    print(f"{C}USAGE:{W}")
    print(f"  sqleasy <command> [options]\n")
    print(f"{C}COMMANDS:{W}")
    print(f"  {G}start{W}                  Launch SQL Easy scan pipeline")
    print(f"  {G}install{W}                Install all required backend tools")
    print(f"  {G}uninstall{W}              Remove all installed backend tools")
    print(f"  {G}update{W}                 Pull the latest version from GitHub")
    print(f"  {G}logs{W}                   Open log manager (view/delete previous results)")
    print(f"  {G}report{W}                 Show scan report summary (CSV + JSON)")
    print(f"  {G}clear{W}                  Wipe all logs and temp files clean")
    print(f"  {G}version{W}                Show current version")
    print(f"  {G}help{W}  |  {G}-h{W}           Show this help menu\n")
    print(f"{C}SCAN OPTIONS:{W}")
    print(f"  {Y}-d, --domain <domain>{W}  Target domain to scan (e.g. example.com)")
    print(f"  {Y}-t, --threads <n>{W}      Concurrency threads for recon (default: 10)")
    print(f"  {Y}--proxy <url>{W}          Route traffic through proxy (http/socks5)")
    print(f"  {Y}--delay <n>{W}            Seconds between requests (WAF evasion)")
    print(f"  {Y}--level <1-5>{W}          SQLMap test level (default: 3)")
    print(f"  {Y}--risk  <1-3>{W}          SQLMap risk level (default: 2)")
    print(f"  {Y}--tables{W}               Also enumerate DB tables (extends --dbs)")
    print(f"  {Y}--dump{W}                 Dump full table contents (use responsibly)\n")
    print(f"{C}EXAMPLES:{W}")
    print(f"  {W}sqleasy start")
    print(f"  {W}sqleasy start -d example.com")
    print(f"  {W}sqleasy start -d example.com -t 20 --level 5 --risk 3")
    print(f"  {W}sqleasy start -d example.com --tables")
    print(f"  {W}sqleasy start -d example.com --dump")
    print(f"  {W}sqleasy start -d example.com --proxy http://127.0.0.1:8080 --delay 3")
    print(f"  {W}sqleasy start -d example.com --proxy socks5://127.0.0.1:9050")
    print(f"  {W}sqleasy logs")
    print(f"  {W}sqleasy report")
    print(f"  {W}sqleasy clear")
    print(f"  {W}sqleasy install")
    print(f"  {W}sqleasy update")
    print(f"  {W}sqleasy uninstall\n")
    print(f"{C}DOCUMENTATION:{W}")
    print(f"  {W}https://github.com/syed-sameer-ul-hassan/SQL-Easy\n")

def run_in_dir(script, extra_args=None):
    install_dir = get_install_dir()
    cmd = [sys.executable, os.path.join(install_dir, script)]
    if extra_args:
        cmd += extra_args
    try:
        subprocess.run(cmd, cwd=install_dir)
    except KeyboardInterrupt:
        print(f"\n{R}[!] Interrupted.{W}")

def cmd_start(extra_args):
    os.system("clear")
    run_in_dir("main.py", extra_args)

def cmd_install():
    os.system("clear")
    run_in_dir("start.py")

def cmd_uninstall():
    os.system("clear")
    run_in_dir("uninstall.py")

def cmd_logs():
    os.system("clear")
    run_in_dir("main.py", ["--logs"])

def cmd_report():
    os.system("clear")
    run_in_dir("main.py", ["--report"])

def cmd_clear():
    os.system("clear")
    run_in_dir("main.py", ["--clear"])

def cmd_version():
    print_banner()
    print(f"{G}[+] SQL Easy v1.1.0{W}")
    print(f"{C}[*] Pipeline: subfinder -> httpx -> arjun -> katana/waybackurls/gau -> sqlmap -> nuclei{W}\n")

def cmd_update():
    install_dir = get_install_dir()
    git_dir = os.path.join(install_dir, ".git")
    if not os.path.exists(git_dir):
        print(f"{Y}[*] SQL Easy is running as a package or system installation.{W}")
        print(f"{C}[>] To upgrade, please run: sudo apt install --only-upgrade sqleasy or download the latest .deb file.{W}")
        return
    print(f"{C}[>] Pulling latest version from GitHub...{W}")
    try:
        subprocess.run(["git", "pull"], cwd=install_dir, check=True)
        print(f"{G}[+] SQL Easy updated successfully!{W}")
    except subprocess.CalledProcessError:
        print(f"{R}[-] Update failed. Check your internet connection.{W}")
    except FileNotFoundError:
        print(f"{R}[-] Git not found. Install with: sudo apt install git{W}")

def main():
    args = sys.argv[1:]

    if not args or args[0] in ("help", "-h", "--help"):
        print_help()
        return

    command = args[0]
    rest = args[1:]

    if command == "start":
        cmd_start(rest)
    elif command == "install":
        cmd_install()
    elif command == "uninstall":
        cmd_uninstall()
    elif command == "update":
        cmd_update()
    elif command == "logs":
        cmd_logs()
    elif command == "report":
        cmd_report()
    elif command == "clear":
        cmd_clear()
    elif command in ("version", "-v", "--version"):
        cmd_version()
    else:
        print(f"{R}[-] Unknown command: '{command}'{W}")
        print(f"{Y}[*] Run 'sqleasy help' to see all available commands.{W}\n")

if __name__ == "__main__":
    main()
